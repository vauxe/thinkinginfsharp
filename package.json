{
  "name": "thinking-in-fsharp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "generate:glossary": "node scripts/generate-glossary.mjs",
    "check:glossary": "node scripts/generate-glossary.mjs --check",
    "generate:solutions-guide": "node scripts/generate-solutions-guide.mjs",
    "check:solutions-guide": "node scripts/generate-solutions-guide.mjs --check",
    "check:parity": "node scripts/check-parity.mjs",
    "check:content": "pnpm check:glossary && pnpm check:solutions-guide && node scripts/check-content.mjs",
    "check:examples": "node scripts/check-examples.mjs && pnpm check:fable",
    "check:fable": "pnpm --filter @thinking-in-fsharp/fable-sample build && pnpm --filter @thinking-in-fsharp/fable-sample smoke",
    "check:capstone": "node scripts/check-capstone.mjs",
    "test:content": "node --test scripts/content-contract.test.mjs scripts/markdown.test.mjs scripts/content-checks.test.mjs scripts/example-checks.test.mjs scripts/glossary.test.mjs scripts/solutions-guide.test.mjs",
    "test": "pnpm test:content && pnpm check:parity && pnpm check:content && pnpm check:examples && pnpm build"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "11.7.0"
  },
  "devDependencies": {
    "markdown-it": "15.0.0",
    "playwright-core": "1.62.1",
    "vitepress": "1.6.4",
    "yaml": "2.9.0"
  }
}
